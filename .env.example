# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development

# Admin (seeded automatically on first run if not present)
ADMIN_EMAIL=awanishkumarmishra2005@gmail.com
ADMIN_PASSWORD=change-this-strong-password

# Payment mode: "test" or "live"
# NEVER set PAYMENT_MODE=test together with FLASK_ENV=production
PAYMENT_MODE=test

# Razorpay (required only when PAYMENT_MODE=live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Pricing (paise) - backend is the source of truth, frontend never sets this
INTERMEDIATE_PRICE_PAISE=2000
ADVANCED_PRICE_PAISE=3000

# Database
DATABASE_URL=sqlite:///instance/beat_ai.db
